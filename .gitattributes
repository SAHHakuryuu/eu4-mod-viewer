# Normalise line endings in the repository to LF...
* text=auto eol=lf

# ...except Windows batch files, which cmd.exe parses incorrectly with bare LF.
# The launcher .bat files are also deliberately pure ASCII: cmd reads batch files
# in the OEM code page, so CJK text inside one gets mis-parsed. Keep it that way.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dds binary
*.tga binary
*.woff binary
*.woff2 binary
*.ttf binary

# Hand-written term tables. These are ours; the wiki-derived tables that used to
# live next to them in src/data/*.json are deliberately not in the repository
# (their source wiki is CC BY-NC-SA, see .gitignore). Collapse them in diffs.
src/data/modifiers-curated.js linguist-generated=true
src/data/effects-curated.js linguist-generated=true

# Documentation.
*.md text
docs/*.png binary
